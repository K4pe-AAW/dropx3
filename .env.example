# OpenAI (used by the collector to draft original articles from source facts)
OPENAI_API_KEY=

# Vercel Blob (data persistence). Create a Blob store in the Vercel dashboard
# (Storage tab) and connect it to this project — the token below is
# auto-injected into your Vercel deployment's env vars when you do that.
# For local dev, copy the same value here (or `vercel env pull .env.local`).
# Without this set, lib/storage.ts throws — there is no local-file fallback.
BLOB_READ_WRITE_TOKEN=

# Shared secret for the collector cron endpoint: GET /api/cron/collect
# Vercel Cron (see vercel.json) sends this automatically as `Authorization: Bearer <value>`.
# Any other external scheduler can instead send `x-cron-secret: <value>`.
CRON_SECRET=

# Password gate for /admin (draft review/publish UI). Required in production —
# without it, anyone could trigger collection or publish drafts on your public site.
ADMIN_PASSWORD=

# Public site URL, used for sitemap.xml / OGP absolute URLs / canonical links.
NEXT_PUBLIC_SITE_URL=https://dropwire.example.com

# --- Affiliate (A8.net) ---
# Your A8.net "material ID" / site ID, if you generate affiliate URLs programmatically.
# Most of the time you'll paste full tracking links from the A8.net dashboard directly
# into an article's affiliateLinks[].url instead — see lib/affiliate.ts.
A8NET_SITE_ID=

# --- Affiliate (ValueCommerce) ---
VALUECOMMERCE_SID=
VALUECOMMERCE_PID=

# --- 計測(GA4 / Search Console) ---
# 未設定なら計測タグ自体を描画しない(components/Analytics.tsx)。/admin配下は
# 測定IDがあっても計測しない(運営者自身の作業がPVに混ざるのを防ぐため)。
#
# GA4: https://analytics.google.com/ でプロパティを作成 -> 管理 > データストリーム ->
# ウェブストリームの「測定ID」(G-で始まる文字列)をコピー。
NEXT_PUBLIC_GA_MEASUREMENT_ID=
#
# Search Console: https://search.google.com/search-console/ でプロパティ追加(URLプレフィックス) ->
# 所有権の確認 > 「HTMLタグ」を選択 -> content="..."の値だけをコピー(<meta ...>タグ全体ではない)。
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- 広告(Google AdSense) ---
# 未設定なら広告タグ自体を描画せずads.txtも空にする(components/AdsenseAutoAds.tsx、
# app/ads.txt/route.ts)。/admin配下は設定があっても広告を出さない。
# AdSense: https://adsense.google.com/ の「アカウント」>「アカウント情報」で
# パブリッシャーID("ca-pub-"で始まる文字列)をコピー。オート広告のみ対応
# (AdSlot.tsx/Sidebar.tsxの既存プレースホルダー枠に個別のディスプレイ広告ユニットを
# 割り当てたい場合は別途コードの変更が必要)。
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# --- SOURCE WATCH: optional primary-source web search (lib/source-watch/web-search.ts) ---
# Without these, "公式情報を検索" in /admin/source-watch just links out to registered
# official Sources + a plain Google search URL for a human to check manually.
# Set both to make it actually call Google Programmable Search Engine and return real results:
# 1. Create a search engine (scope: entire web) at https://programmablesearchengine.google.com/ -> get GOOGLE_CSE_CX
# 2. Enable "Custom Search JSON API" in Google Cloud Console -> get GOOGLE_CSE_API_KEY
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
