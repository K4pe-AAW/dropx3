# OpenAI (used by the collector to draft original articles from source facts)
OPENAI_API_KEY=

# Shared secret for the collector cron endpoint: GET /api/cron/collect
# with header `x-cron-secret: <this value>`
CRON_SECRET=

# Password gate for /admin (draft review/publish UI). Required in production —
# without it, anyone could trigger collection or publish drafts on your public site.
ADMIN_PASSWORD=

# Public site URL, used for sitemap.xml / OGP absolute URLs / canonical links.
NEXT_PUBLIC_SITE_URL=https://dropwire.example.com

# --- Affiliate (A8.net) ---
# Your A8.net "material ID" / site ID, if you generate affiliate URLs programmatically.
# Most of the time you'll paste full tracking links from the A8.net dashboard directly
# into an article's affiliateLinks[].url instead — see lib/affiliate.ts.
A8NET_SITE_ID=

# --- Affiliate (ValueCommerce) ---
VALUECOMMERCE_SID=
VALUECOMMERCE_PID=
